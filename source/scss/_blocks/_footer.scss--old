.footer {
  margin-top: auto;

  &__content {
    padding: 72px;
    background-color: #2e2e2e;
    border-radius: 16px 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 80px 64px;
  }

  &__block {
    font-weight: 600;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-white-half);
    display: flex;
    flex-direction: column;
    gap: 32px;

    &:nth-last-of-type(2) {
      margin-right: auto;
    }
  }

  &__caption {
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: #ffffff;
  }

  &__menu {
    display: flex;
    flex-direction: column;
    gap: 16px;

    a {
      font-weight: 400;
      font-size: 16px;
      line-height: 1.25;
      color: var(--color-white-half);
      display: flex;
      align-items: center;
      gap: 12px;
    }
  }

  &__form {
    display: flex;
    gap: 16px;

    input {
      font-weight: 400;
      font-size: 16px;
      line-height: 1.5;
      color: var(--color-black-half);
      width: 100%;
      padding: 12px;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 8px;
    }

    .btn {
      padding-inline: 40px;
    }
  }

  &__copyright {
    font-weight: 400;
    font-size: 16px;
    line-height: 1.25;
    color: var(--color-white-half);
    width: 100%;
  }
}

@media (max-width: $xl) {
  .footer {
    &__content {
      padding: 56px;
      gap: 80px 48px;
    }
  }
}

@media (max-width: $md) {
  .footer {
    &__content {
      padding: 16px 24px;
      gap: 70px 48px;
    }

    &__copyright {
      text-align: center;
    }
  }
}

@media (max-width: $sm) {
  .footer {
    .wrapper {
      background-color: #2e2e2e;
    }

    &__content {
      padding: 24px 16px;
      gap: 52px 36px;
    }

    &__menu {
      a {
        max-width: 185px;
      }
    }

    &__form {
      flex-direction: column;

      .btn {
        width: 100%;
      }
    }
  }
}
